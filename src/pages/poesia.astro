<style>
    /* SECCIÓN DE POESÍA */
    .Poesia {
        width: 90%;
        max-width: 1250px;
        margin: 35px auto 50px;
        color: #292722;
        font-family: Georgia, "Times New Roman", serif;
    }

    /* TÍTULO */
    .Poesia h1 {
        margin: 0;
        font-size: 40px;
        font-weight: normal;
        line-height: 1.2;
    }

    /* CONTENEDOR DE LIBROS */
    .libros {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 38px;
        width: 100%;
    }

    /* CADA LIBRO */
    .libro {
        width: 145px;
        flex-shrink: 0;
        text-align: center;
    }

    /* PORTADA */
    .libro img {
        width: 138px;
        height: 207px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    /* TÍTULO DEL LIBRO */
    .libro h2 {
        min-height: 36px;
        margin: 16px 0 5px;
        font-size: 13px;
        line-height: 18px;
        font-weight: normal;
    }

    .libro h3 {
    }

    /*Solo es un espaciador */
    .espacio {
        margin-bottom: 50px;
    }

    /* AUTOR */
    .libro p {
        min-height: 32px;
        margin: 0;
        font-size: 11px;
        line-height: 15px;
        color: #716d65;
    }

    /* BOTÓN */
    .libro button {
        width: 87px;
        height: 34px;
        margin-top: 14px;
        background-color: transparent;
        border: 1px solid #aaa59c;
        color: #403d37;
        font-family: Georgia, "Times New Roman", serif;
        cursor: pointer;
    }

    /* EFECTO DEL BOTÓN */
    .libro button:hover {
        background-color: #292720;
        color: white;
    }

    /* PANTALLAS PEQUEÑAS */
    @media (max-width: 1100px) {
        .libros {
            flex-wrap: wrap;
            gap: 35px;
        }
    }

    /* El fondo oscuro que cubre toda la pantalla */
    .modal {
        display: none; /* Oculto por defecto */
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6); /* Fondo negro translúcido */
        z-index: 9999; /* Número alto para que tape todo el contenido */
        justify-content: center;
        align-items: center;
    }

    /* La caja blanca con el texto del libro */
    .contenido-modal {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        width: 90%;
        max-width: 450px;
        position: relative;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        color: #333;
        text-align: left;
    }

    /* El botón para cerrar */
    .cerrar {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        color: #aaa;
    }

    .cerrar:hover {
        color: #000;
    }
</style>

<script>
    // función que encapsule toda la lógica de los modales
    function inicializarModales() {
        // se seleccionan todos los botones que abren ventanas modales
        const botonesAbrir = document.querySelectorAll(".btn-abrir");

        botonesAbrir.forEach((boton) => {
            boton.addEventListener("click", () => {
                // se obtiene el ID de la ventana desde el atributo data-target
                const idModal = boton.getAttribute("data-target");

                if (idModal) {
                    const modal = document.getElementById(
                        idModal,
                    ) as HTMLElement | null;
                    if (modal) {
                        modal.style.display = "flex";
                    }
                }
            });
        });

        // todos los botones de cerrar (X)
        const botonesCerrar = document.querySelectorAll(".cerrar");

        botonesCerrar.forEach((boton) => {
            boton.addEventListener("click", () => {
                // busca la ventana modal más cercana y le se asegura el tipo HTMLElement
                const modal = boton.closest(".modal") as HTMLElement | null;
                if (modal) {
                    modal.style.display = "none";
                }
            });
        });
    }

    // evento de Astro para volver a ejecutar la función en cada cambio de página esto es necesario para que no deje de seguirlo buscando
    document.addEventListener("astro:page-load", inicializarModales);
</script>
