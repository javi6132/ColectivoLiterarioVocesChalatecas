---
import Layout from "./Layout/Layout.astro";
---

<Layout title="Poesia | Voces Chalatecas">
    <section class="Poesia" id="poesia">
        <h1>Poemas publicados</h1>
<h3></h3>
        <div class="espacio"></div>

        <section class="libros">
            <!-- LIBRO 1 -->
            <article class="libro">
                <img src="imagenes/ejemplo1.jpg" alt="Ventiladores Clyde" />

                <h2>VENTILADORES<br />CLYDE</h2>

                <p>SETH</p>

                <button>Ver</button>
            </article>

            <article class="libro">
                <img src="imagenes/ejemplo2.jpg" alt="Algún Día, Hoy" />

                <h2>ALGÚN DÍA, HOY</h2>

                <p>BECERRA, ÁNGELA</p>

                <button>Ver</button>
            </article>

            <article class="libro">
                <img
                    src="imagenes/palabras-rotas.jpg"
                    alt="Las Palabras Rotas"
                />

                <h2>LAS PALABRAS<br />ROTAS</h2>

                <p>GARCÍA MONTERO,<br />LUIS</p>

                <button>Ver</button>
            </article>

            <article class="libro">
                <img
                    src="imagenes/largo-petalo-mar.jpg"
                    alt="Largo Pétalo de Mar"
                />

                <h2>LARGO PÉTALO DE<br />MAR</h2>

                <p>ALLENDE, ISABEL</p>

                <button>Ver</button>
            </article>

            <article class="libro">
                <img
                    src="imagenes/anos-terribles.jpg"
                    alt="Antes de los Años Terribles"
                />

                <h2>ANTES DE LOS<br />AÑOS TERRIBLES</h2>

                <p>DEL ÁRBOL, VÍCTOR</p>

                <button>Ver</button>
            </article>

            <article class="libro">
                <img
                    src="imagenes/mi-vida-en-barco.jpg"
                    alt="Mi Vida en Barco"
                />

                <h2>MI VIDA EN BARCO</h2>

                <p>TSUGE, TADIO</p>

                <button>Ver</button>
            </article>
        </section>
    </section>
</Layout>

<style>

    /* SECCIÓN DE POESÍA */
    .Poesia {
        width: 90%;
        max-width: 1250px;

        margin: 35px auto 50px;

        color: #292722;

        font-family: Georgia, "Times New Roman", serif;
    }

    /* TÍTULO */
    .Poesia h1 {

        margin: 0;

        font-size: 40px;

        font-weight: normal;

        line-height: 1.2;
    }


    /* CONTENEDOR DE LIBROS */
    .libros {

        display: flex;

        justify-content: center;

        align-items: flex-start;

        gap: 38px;

        width: 100%;
    }


    /* CADA LIBRO */
    .libro {

        width: 145px;

        flex-shrink: 0;

        text-align: center;
    }

    /* PORTADA */
    .libro img {

        width: 138px;

        height: 207px;

        object-fit: cover;

        display: block;

        margin: 0 auto;

        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    /* TÍTULO DEL LIBRO */
    .libro h2 {

        min-height: 40px;

        margin: 16px 0 5px;

        font-size: 13px;

        line-height: 18px;

        font-weight: normal;
    }

    /*Solo es un espaciador */
    .espacio {  
        margin-bottom: 50px; 
    }

    /* AUTOR */
    .libro p {

        min-height: 32px;

        margin: 0;

        font-size: 11px;

        line-height: 15px;

        color: #716d65;
    }


  
    /* BOTÓN */
    .libro button {

        width: 87px;

        height: 34px;

        margin-top: 14px;

        background-color: transparent;

        border: 1px solid #aaa59c;

        color: #403d37;

        font-family: Georgia, "Times New Roman", serif;

        cursor: pointer;
    }

    /* EFECTO DEL BOTÓN */
    .libro button:hover {

        background-color: #292720;

        color: white;
    }

    /* PANTALLAS PEQUEÑAS */
    @media (max-width: 1100px) {

        .libros {

            flex-wrap: wrap;

            gap: 35px;
        }

    }

</style>