<style>

    .Poesia {
        width: 92%;
        max-width: 1250px;
        margin: clamp(20px, 5vw, 35px) auto 50px;
        color: #292722;
        font-family: Georgia, "Times New Roman", serif;
    }

    .Poesia h1 {
        margin: 0;
        font-size: clamp(26px, 6vw, 40px);
        font-weight: normal;
        line-height: 1.2;
        text-align: center;
    }

    .espacio {
        margin-bottom: clamp(24px, 5vw, 50px);
    }

    /* GRILLA DE LIBROS */
    .libros {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 145px));
        justify-content: center;
        gap: clamp(20px, 4vw, 38px);
        width: 100%;
    }

    .libro {
        width: 100%;
        text-align: center;
    }

    .libro > img {
        width: 100%;
        max-width: 138px;
        aspect-ratio: 2 / 3;
        height: auto;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    .libro > h2 {
        min-height: 36px;
        margin: 16px 0 5px;
        font-size: 13px;
        line-height: 18px;
        font-weight: normal;
    }

    .libro > p {
        min-height: 32px;
        margin: 0;
        font-size: 11px;
        line-height: 15px;
        color: #716d65;
    }

    .btn-abrir {
        width: 87px;
        min-height: 40px;
        margin-top: 14px;
        background-color: transparent;
        border: 1px solid #aaa59c;
        color: #403d37;
        font-family: Georgia, "Times New Roman", serif;
        cursor: pointer;
    }

    .btn-abrir:hover {
        background-color: #292720;
        color: white;
    }

    /*  MODAL  */
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        padding: 16px;
        box-sizing: border-box;
        background-color: rgba(0, 0, 0, 0.6);
        justify-content: center;
        align-items: center;
    }

    .modal.abierto {
        display: flex;
    }

    .contenido-modal {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 600px;
        max-height: 85vh;
        max-height: 85dvh;
        box-sizing: border-box;
        overflow: hidden;
        border-radius: 10px;
        background-color: #ffffff;
        color: #333333;
        text-align: left;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .cabecera-modal {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        flex-shrink: 0;
        padding: 8px 12px;
        box-sizing: border-box;
        background-color: #ffffff;
        border-bottom: 1px solid #eeeeee;
    }

    .controles-lectura {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .controles-lectura button {
        min-height: 40px;
        min-width: 40px;
        padding: 6px 12px;
        border: 1px solid #aaa59c;
        border-radius: 3px;
        background: transparent;
        color: #403d37;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 14px;
        cursor: pointer;
    }

    .controles-lectura button:hover {
        background-color: #e8e2d8;
    }

    .cerrar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-left: auto;
        padding: 0;
        border: 1px solid #aaa59c;
        border-radius: 3px;
        background: transparent;
        color: #716d65;
        font-family: Arial, sans-serif;
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
    }

    .cerrar:hover {
        background-color: #e8e2d8;
        color: #000000;
    }

    .cuerpo-modal {
        flex: 1;
        min-height: 0;
        padding: 20px clamp(16px, 5vw, 30px) 30px;
        overflow-y: auto;
        overflow-wrap: anywhere;
        text-align: left;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    .cuerpo-modal h3 {
        margin: 0 0 15px;
        text-align: center;
        font-weight: normal;
        font-size: clamp(18px, 4.5vw, 22px);
    }

    .cuerpo-modal .texto-poema {
        margin: 15px 0 20px;
        color: #716d65;
        font-size: 16px;
        line-height: 1.8;
        text-align: center;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .cuerpo-modal h2 {
        min-height: 0;
        margin: 0;
        text-align: right;
        font-size: 16px;
        font-weight: normal;
    }

    /*  MODO OSCURO  */
    .modal.modo-oscuro .contenido-modal {
        background-color: #252420;
        color: #e9e2d7;
        border: 1px solid #49463f;
    }

    .modal.modo-oscuro .cabecera-modal {
        background-color: #252420;
        border-bottom-color: #49463f;
    }

    .modal.modo-oscuro .texto-poema {
        color: #e9e2d7;
    }

    .modal.modo-oscuro .controles-lectura button,
    .modal.modo-oscuro .cerrar {
        color: #e9e2d7;
        border-color: #625d53;
    }

    .modal.modo-oscuro .controles-lectura button:hover,
    .modal.modo-oscuro .cerrar:hover {
        background-color: #49463f;
        color: #ffffff;
    }

    /* TABLET */
    @media (max-width: 900px) {
        .libros {
            grid-template-columns: repeat(auto-fill, minmax(140px, 150px));
        }
    }

    /*  MÓVIL  */
    @media (max-width: 600px) {
        .libros {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px 16px;
        }

        .libro > img {
            max-width: 100%;
        }

        .btn-abrir {
            width: 100%;
            max-width: 120px;
        }

        .modal {
            padding: 8px;
        }

        .contenido-modal {
            max-height: 92vh;
            max-height: 92dvh;
        }

        .controles-lectura button {
            font-size: 13px;
            padding: 6px 10px;
        }

        .cuerpo-modal .texto-poema {
            font-size: 15px;
            line-height: 1.7;
        }
    }

    /* MÓVIL MUY PEQUEÑO */
    @media (max-width: 360px) {
        .libros {
            grid-template-columns: 1fr;
        }

        .libro > img {
            max-width: 160px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .contenido-modal {
            transition: none;
        }
    }
</style>

<script>
    function actualizarBloqueoScroll() {
        const hayAbierto = document.querySelector(
            ".modal[data-portal='poesia'].abierto",
        );
        document.body.style.overflow = hayAbierto ? "hidden" : "";
    }

    function cerrarTodos() {
        document
            .querySelectorAll(".modal[data-portal='poesia']")
            .forEach((m) => m.classList.remove("abierto"));
        actualizarBloqueoScroll();
    }

    function inicializarModales() {
        const raiz = document.querySelector<HTMLElement>("#poesia");

        if (!raiz || raiz.dataset.inicializada === "true") return;

        raiz.dataset.inicializada = "true";

        // Limpiar modales de una visita anterior (si la página se recarga con transiciones)
        document
            .querySelectorAll(".modal[data-portal='poesia']")
            .forEach((m) => m.remove());
        document.body.style.overflow = "";

        const modales = Array.from(
            raiz.querySelectorAll<HTMLElement>(".modal"),
        );

        modales.forEach((modal) => {
            // Mover el modal al <body> para que quede por encima del footer
            modal.dataset.portal = "poesia";
            document.body.appendChild(modal);

            const texto = modal.querySelector<HTMLElement>(".texto-poema");
            const aumentar =
                modal.querySelector<HTMLButtonElement>(".aumentar-letra");
            const disminuir =
                modal.querySelector<HTMLButtonElement>(".disminuir-letra");
            const botonTema =
                modal.querySelector<HTMLButtonElement>(".alternar-tema");

            if (!texto || !aumentar || !disminuir || !botonTema) return;

            let tamano = 16;

            botonTema.addEventListener("click", () => {
                const oscuro = modal.classList.toggle("modo-oscuro");
                botonTema.textContent = oscuro
                    ? "☀ Modo claro"
                    : "☾ Modo oscuro";
                botonTema.setAttribute("aria-pressed", String(oscuro));
            });

            aumentar.addEventListener("click", () => {
                tamano = Math.min(tamano + 2, 28);
                texto.style.fontSize = `${tamano}px`;
            });

            disminuir.addEventListener("click", () => {
                tamano = Math.max(tamano - 2, 10);
                texto.style.fontSize = `${tamano}px`;
            });
        });
    }

    // Listeners globales: se registran una sola vez
    const w = window as any;
    if (!w.__poesiaListeners) {
        w.__poesiaListeners = true;

        document.addEventListener("click", (evento) => {
            const objetivo = evento.target;
            if (!(objetivo instanceof Element)) return;

            // Abrir
            const botonAbrir =
                objetivo.closest<HTMLButtonElement>(".btn-abrir");
            if (botonAbrir && botonAbrir.closest("#poesia")) {
                const idModal = botonAbrir.dataset.target;
                const modal = idModal
                    ? document.querySelector<HTMLElement>(
                          `.modal[data-portal='poesia']#${idModal}`,
                      )
                    : null;

                if (modal) {
                    modal.classList.add("abierto");
                    actualizarBloqueoScroll();
                    modal.querySelector<HTMLButtonElement>(".cerrar")?.focus();
                }
                return;
            }

            // Cerrar con la X
            const botonCerrar = objetivo.closest<HTMLButtonElement>(
                ".modal[data-portal='poesia'] .cerrar",
            );
            if (botonCerrar) {
                botonCerrar
                    .closest<HTMLElement>(".modal")
                    ?.classList.remove("abierto");
                actualizarBloqueoScroll();
                return;
            }

            // Cerrar al pulsar el fondo oscuro
            if (
                objetivo instanceof HTMLElement &&
                objetivo.matches(".modal[data-portal='poesia']")
            ) {
                objetivo.classList.remove("abierto");
                actualizarBloqueoScroll();
            }
        });

        document.addEventListener("keydown", (evento) => {
            if (evento.key === "Escape") cerrarTodos();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", inicializarModales, {
            once: true,
        });
    } else {
        inicializarModales();
    }

    document.addEventListener("astro:page-load", inicializarModales);
</script>