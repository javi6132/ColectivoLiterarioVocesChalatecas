<style>
    /* SECCIÓN DE POESÍA */
    .Poesia {
        width: 90%;
        max-width: 1250px;
        margin: 35px auto 50px;
        color: #292722;
        font-family: Georgia, "Times New Roman", serif;
    }

    /* TÍTULO */
    .Poesia h1 {
        margin: 0;
        font-size: 40px;
        font-weight: normal;
        line-height: 1.2;
    }

    /* CONTENEDOR DE LIBROS */
    .libros {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 38px;
        width: 100%;
    }

    /* CADA LIBRO */
    .libro {
        width: 145px;
        flex-shrink: 0;
        text-align: center;
    }

    /* PORTADA */
    .libro img {
        width: 138px;
        height: 207px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    /* TÍTULO DEL LIBRO */
    .libro h2 {
        min-height: 36px;
        margin: 16px 0 5px;
        font-size: 13px;
        line-height: 18px;
        font-weight: normal;
    }

    .libro h3 {
        text-align: center;
    }

    /*Solo es un espaciador */
    .espacio {
        margin-bottom: 50px;
    }

    /* AUTOR */
    .libro p {
        min-height: 32px;
        margin: 0;
        font-size: 11px;
        line-height: 15px;
        color: #716d65;
    }

    /* BOTÓN */
    .libro button {
        width: 87px;
        height: 34px;
        margin-top: 14px;
        background-color: transparent;
        border: 1px solid #aaa59c;
        color: #403d37;
        font-family: Georgia, "Times New Roman", serif;
        cursor: pointer;
    }

    /* EFECTO DEL BOTÓN */
    .libro button:hover {
        background-color: #292720;
        color: white;
    }

    /* PANTALLAS PEQUEÑAS */
    @media (max-width: 1100px) {
        .libros {
            flex-wrap: wrap;
            gap: 35px;
        }
    }


/* Fondo oscuro de la ventana */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
}

/* Caja principal */
.contenido-modal {
    background-color: #ffffff;
    width: 80%;
    max-width: 600px;
    max-height: 75vh;
    border-radius: 10px;
    box-sizing: border-box;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    color: #333;

    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Cabecera fija con la X */
.cabecera-modal {
    position: relative;
    flex-shrink: 0;
    height: 50px;
    background-color: #ffffff;
    border-bottom: 1px solid #eee;
}

/* Botón para cerrar */
.cerrar {
    position: absolute;
    top: 5px;
    right: 15px;
    font-size: 30px;
    font-weight: bold;
    cursor: pointer;
    color: #aaa;
    line-height: 35px;
}

.cerrar:hover {
    color: #000;
}

/* Solo esta parte tendrá scroll */
.cuerpo-modal {
    padding: 20px 30px 30px;
    overflow-y: auto;
    min-height: 0;
    overflow-wrap: anywhere;
    text-align: left;
}

/* Texto del poema */
.cuerpo-modal .texto-poema {
    text-align: center;
    font-size: 16px;
    line-height: 1.8;
    color: #716d65;
    margin: 15px 0 20px;
    white-space: normal;
    overflow-wrap: anywhere;
}

