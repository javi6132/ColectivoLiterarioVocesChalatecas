<Layout title="Galería | Voces Chalatecas">
  <section class="galeria" id="galeria">
    <div class="galeria-container">

      <h1>Galería</h1>
      <p class="galeria-intro">
        Un vistazo a nuestros videos.
      </p>

      <div class="reels-grid">
        {videos.map(({ url, horizontal }) => (
          <div class={`reel-card ${horizontal ? "horizontal" : ""}`}>
            <iframe
              src={`https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=${horizontal ? 704 : 340}`}
              loading="lazy"
              title="Video de Voces Chalatecas"
              scrolling="no"
              allowfullscreen="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            ></iframe>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .galeria {
    padding: 30px 0 80px;
  }

  .galeria-container {
    width: min(90%, 1100px);
    margin-inline: auto;
  }

  h1 {
    margin: 0 0 15px;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .galeria-intro {
    margin: 0 0 40px;
    line-height: 1.7;
    max-width: 700px;
  }

  /* VIDEOS: verticales por defecto, llenando su columna */
  .reels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 340px));
    grid-auto-flow: dense; /* evita huecos entre verticales y horizontales */
    justify-content: center;
    gap: 24px;
    width: 100%;
    margin: 0 auto;
  }

  .reel-card {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #111;
    border-radius: 10px;
    overflow: hidden;
  }

  /* Video horizontal: ocupa 2 columnas en proporción 16:9 */
  .reel-card.horizontal {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  .reel-card iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* TABLET */
  @media (max-width: 900px) {
    .reels-grid {
      grid-template-columns: repeat(2, minmax(0, 340px));
      gap: 16px;
    }
  }

  /* MÓVIL */
  @media (max-width: 600px) {
    .galeria {
      padding: 20px 0 60px;
    }

    .reels-grid {
      grid-template-columns: minmax(0, 380px);
    }

    .reel-card.horizontal {
      grid-column: span 1;
    }
  }
</style>