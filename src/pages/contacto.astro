---
import Layout from "./Layout/Layout.astro";
---

<Layout title="Contacto | Voces Chalatecas">
  <section class="contacto" id="contacto">
    <div class="contacto-container">

      <h1>Contacto</h1>

      <div class="contacto-grid">

        <!-- IMAGEN -->
        <div class="retrato">
          <img
            src="/imagenes/contacto.jpg"
            alt="Retrato de Voces Chalatecas"
          />
        </div>

        <!-- FORMULARIO -->
        <form
          class="contacto-form"
          id="contacto-form"
          action="https://formspree.io/f/xoevewan"
          method="POST"
        >
          <label for="nombre">Nombre</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            pattern="[A-Za-zÀ-ÖØ-öø-ÿÑñ\s]+"
            required
          />

          <label for="email">Correo</label>
          <input
            type="email"
            id="email"
            name="email"
            required
          />

          <label for="mensaje">Mensaje</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="8"
            required
          ></textarea>

          <button type="submit" id="contacto-submit">
            ENVIAR MENSAJE
          </button>

          <!-- Mensajes de estado (ocultos por defecto) -->
          <p class="form-status form-status--success" role="status" aria-live="polite">
            ¡Gracias! Tu mensaje fue enviado. Te responderemos pronto.
          </p>
          <p class="form-status form-status--error" role="alert" aria-live="assertive">
            Hubo un problema al enviar tu mensaje. Intenta de nuevo o escríbenos directamente por correo.
          </p>
        </form>

      </div>

      <!-- INFORMACIÓN DE CONTACTO -->
      <div class="contacto-info">

        <p class="contacto-intro">
          ¿Quieres escribirnos, invitarnos a un evento o compartir tu voz
          con el colectivo? Estaremos felices de leerte.
        </p>

        <div class="divisor"></div>

        <h2>Escríbenos</h2>

        <div class="contacto-datos">

          <!-- CORREO Y UBICACIÓN -->
          <div class="datos-izquierda">

            <p class="dato">
              <strong>Correo:</strong>
              <a href="mailto:contacto@vocesChalatecas.org">
                contacto@vocesChalatecas.org
              </a>
            </p>

            <p class="dato">
              <strong>Ubicación:</strong>
              <span>Chalatenango, El Salvador</span>
            </p>

          </div>

          <!-- REDES SOCIALES -->
          <div class="redes">

            <strong>Redes:</strong>

            <div class="redes-iconos">

              <!-- FACEBOOK -->
              <a
                href="https://www.facebook.com/gerardo.alfaro.14"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="red-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
                </svg>
              </a>

              <!-- INSTAGRAM -->
              <a
                href="https://www.instagram.com/alfarero7/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="red-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5"
                  />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line
                    x1="17.5"
                    y1="6.5"
                    x2="17.51"
                    y2="6.5"
                  />
                </svg>
              </a>

            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <script>
    const form = document.getElementById("contacto-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contacto-submit") as HTMLButtonElement | null;

    // Mensajes de validación en español para cada campo
    const mensajesValidacion: Record<string, { vacio: string; invalido?: string }> = {
      nombre: {
        vacio: "Por favor escribe tu nombre.",
        invalido: "El nombre solo puede contener letras y espacios (sin números ni símbolos).",
      },
      email: {
        vacio: "Por favor escribe tu correo electrónico.",
        invalido: "Ese correo no parece válido. Revisa el formato (ejemplo@correo.com).",
      },
      mensaje: { vacio: "Por favor escribe un mensaje." },
    };

    if (form) {
      const campos = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input[name], textarea[name]"
      );

      campos.forEach((campo) => {
        const textos = mensajesValidacion[campo.name];
        if (!textos) return;

        const actualizarMensaje = () => {
          if (campo.validity.valueMissing) {
            campo.setCustomValidity(textos.vacio);
          } else if (
            (campo.validity.typeMismatch || campo.validity.patternMismatch) &&
            textos.invalido
          ) {
            campo.setCustomValidity(textos.invalido);
          } else {
            campo.setCustomValidity("");
          }
        };

        campo.addEventListener("invalid", actualizarMensaje);
        campo.addEventListener("input", actualizarMensaje);
      });
    }

    // Bloquea números y símbolos mientras se escribe en "Nombre"
    const campoNombre = document.getElementById("nombre") as HTMLInputElement | null;
    if (campoNombre) {
      campoNombre.addEventListener("input", () => {
        const limpio = campoNombre.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿÑñ\s]/g, "");
        if (limpio !== campoNombre.value) {
          campoNombre.value = limpio;
        }
      });
    }

    if (form && submitBtn) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        form.classList.remove("is-success", "is-error");

        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "ENVIANDO...";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            form.classList.add("is-success");
            form.reset();
          } else {
            form.classList.add("is-error");
          }
        } catch (err) {
          form.classList.add("is-error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    }
  </script>
</Layout>

<style>
  .contacto {
    padding: 30px 0 80px;
  }

  .contacto-container {
    width: min(90%, 1100px);
    margin: 0 auto;
  }

  h1 {
    margin: 0 0 15px;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 70px;
    align-items: start;
    margin-bottom: 70px;
  }

  /* IMAGEN */
  .retrato {
    width: 100%;
    max-width: 420px;
  }

  .retrato img {
    width: 100%;
    height: 450px;
    display: block;
    object-fit: cover;
    object-position: top center;
  }

  /* FORMULARIO */
  .contacto-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: Arial, Helvetica, sans-serif;
  }

  .contacto-form label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0;
    margin-bottom: 4px;
  }

  .contacto-form input,
  .contacto-form textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    border: 1px solid #cfc6bb;
    background: #fff;
    font: inherit;
    border-radius: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contacto-form input:focus,
  .contacto-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
  }

  .contacto-form input:invalid:not(:placeholder-shown),
  .contacto-form textarea:invalid:not(:placeholder-shown) {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
  }

  .contacto-form input {
    height: 48px;
    margin-bottom: 15px;
  }

  .contacto-form textarea {
    min-height: 180px;
    resize: vertical;
  }

  .contacto-form button {
    margin-top: 15px;
    min-height: 48px;
    border: 0;
    background: var(--color-button);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.25s ease, opacity 0.25s ease;
  }

  .contacto-form button:hover:not(:disabled) {
    background: var(--color-button-hover);
  }

  .contacto-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* MENSAJES DE ESTADO */
  .form-status {
    display: none;
    margin: 4px 0 0;
    padding: 12px 14px;
    font-size: 0.85rem;
    line-height: 1.5;
    border-left: 3px solid transparent;
  }

  .form-status--success {
    background: #f4f2ee;
    border-color: var(--color-button);
    color: #333;
  }

  .form-status--error {
    background: #f4f2ee;
    border-color: var(--color-accent);
    color: #333;
  }

  .contacto-form.is-success .form-status--success,
  .contacto-form.is-error .form-status--error {
    display: block;
  }

  /* INFORMACIÓN */
  .contacto-info {
    width: 100%;
    max-width: 900px;
    text-align: left;
  }

  .contacto-intro {
    margin: 0 0 25px;
    line-height: 1.7;
    max-width: 700px;
  }

  .divisor {
    width: 100%;
    max-width: 700px;
    border-top: 1px solid #e5e0d8;
    margin: 0 0 30px;
  }

  .contacto-info h2 {
    margin: 0 0 20px;
    font-size: 1.5rem;
    font-weight: 400;
  }

  /* CORREO / UBICACIÓN / REDES */
  .contacto-datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }

  .dato {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    line-height: 1.7;
  }

  .dato strong {
    white-space: nowrap;
  }

  .dato a {
    color: inherit;
    text-decoration: none;
  }

  .dato a:hover {
    text-decoration: underline;
  }

  /* REDES */
  .redes {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
  }

  .redes-iconos {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .red-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-accent);
    border: 1px solid #cfc6bb;
    border-radius: 50%;
    text-decoration: none;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .red-link svg {
    width: 18px;
    height: 18px;
  }

  .red-link:hover {
    color: #fff;
    background: var(--color-button);
    border-color: var(--color-button);
    transform: translateY(-2px);
  }

  /* TABLET */
  @media (max-width: 900px) {
    .contacto-grid {
      grid-template-columns: 350px 1fr;
      gap: 40px;
    }

    .retrato img {
      height: 430px;
    }
  }

  /* MÓVIL */
  @media (max-width: 800px) {
    .contacto {
      padding: 20px 0 60px;
    }

    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 50px;
    }

    .retrato {
      max-width: 100%;
    }

    .retrato img {
      height: auto;
      max-height: 500px;
    }

    .contacto-info {
      width: 100%;
      max-width: 100%;
    }

    .contacto-datos {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .redes {
      align-items: flex-start;
    }
  }
</style>