---
import Layout from "./Layout/Layout.astro";

// =====================================================
// EDITA AQUÍ LOS CONTENIDOS DEL INICIO
// =====================================================

const frase =
  "[Una frase que resuma el espíritu de la escritura.]";

const sobreMi = {
  titulo: "Una voz nacida en Chalatenango",
  texto:
    "Soy Juan Gerardo Alfaro Escobar, poeta, educador y orador, nació el 6 de Junio de 1,987 en el Cantón San José, Municipio y Departamento de Chalatenango.",
  imagen: "/imagenes/galeria2.jpg",
};

const libro = {
  titulo: "Fronteras Prohibidas",
  texto:
    "Fronteras Prohibidas es una interesante colección de poemas con un toque literario exquisito y de gran calidad que pretende sumergir al lector en una variedad de temáticas que invitan no sólo a disfrutar cada poema si no también, a poder reflexionar en torno a ellos.",
  portada: "/imagenes/poesia/FronterasProhibidas.jpg",
};

const poema = {
  texto:
    "La inspiración se halla en todas partes; no la busquéis sólo en el corazón de un hombre herido, o en los amores febriles que arrebatan la vida.",
  // Si es una cita de otro autor, escribe aquí su nombre. Si queda vacío, no se muestra.
  autor: "",
};

// Reels que se muestran en "Momentos del colectivo".
// Puedes cambiarlos por cualquiera de la lista de la galería.
const reelsPreview = [
  "https://www.facebook.com/reel/1642400850890747",
  "https://www.facebook.com/reel/1199803644638030",
  "https://www.facebook.com/reel/1598133054596823",
];

---

<Layout title="Voces Chalatecas | Colectivo Literario">

  <!-- =========================
       HERO
  ========================== -->
  <section class="hero">
    <div class="hero-image"></div>
    <div class="hero-overlay"></div>

    <div class="hero-container">
      <div class="hero-content">

        <p class="hero-eyebrow">
          <span class="linea"></span>
          Escritor · Chalatenango
        </p>

        <h1>
          Palabras que<br />
          nacen del alma<br />
          y se quedan en el<br />
          corazón.
        </h1>

        <p class="hero-subtitle">Escritor · Poeta · Soñador</p>

        <div class="hero-botones">
          <a href="/sobre-mi" class="boton boton-primario">CONOCE MI HISTORIA</a> 
          <a href="/poesia" class="boton boton-secundario">LEER POEMAS</a>
        </div>

      </div>
    </div>
  </section>


  <!-- =========================
       FRASE DESTACADA
  ========================== -->
  <section class="frase">
    <div class="contenedor">
      <span class="comilla" aria-hidden="true">“</span>
      <p class="frase-texto reveal">{frase}</p>
    </div>
  </section>


  <!-- =========================
       SOBRE MÍ
  ========================== -->
  <section class="bloque">
    <div class="contenedor bloque-grid tarjeta">

      <div class="marco reveal">
        <img
          src={sobreMi.imagen}
          alt="Retrato del autor"
          loading="lazy"
        />
      </div>

      <div class="bloque-texto reveal" style="--d: 120ms">
        <p class="etiqueta"><span class="num">01</span> Sobre mí</p>
        <h2>{sobreMi.titulo}</h2>
        <p>{sobreMi.texto}</p>
        <a href="/sobre-mi" class="enlace-flecha">
          Leer mi historia <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </section>


  <!-- =========================
       LIBRO DESTACADO
  ========================== -->
  <section class="bloque bloque-tono">
    <div class="contenedor bloque-grid bloque-grid-inverso tarjeta">

      <div class="bloque-texto reveal">
        <p class="etiqueta"><span class="num">02</span> Libro</p>
        <h2>{libro.titulo}</h2>
        <p>{libro.texto}</p>
        <a href="/libro" class="enlace-flecha">
          Conocer el libro <span aria-hidden="true">→</span>
        </a>
      </div>

      <a href="/libro" class="portada-panel reveal" style="--d: 120ms" aria-label={`Ver el libro ${libro.titulo}`}>
        <img
          src={libro.portada}
          alt={`Portada del libro ${libro.titulo}`}
          loading="lazy"
        />
      </a>

    </div>
  </section>


  <!-- =========================
       POESÍA
  ========================== -->
  <section class="poesia">
    <div class="contenedor poesia-caja tarjeta reveal">
      <p class="etiqueta centrada"><span class="num">03</span> Poesía</p>
      <span class="ornamento" aria-hidden="true"></span>

      <blockquote class="poesia-bloque">
        <p class="poesia-verso">{poema.texto}</p>
        {poema.autor && <footer class="poesia-autor">— {poema.autor}</footer>}
      </blockquote>

      <a href="/poesia" class="enlace-flecha">
        Leer más poesía <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>


  <!-- =========================
       GALERÍA (REELS)
  ========================== -->
  <section class="galeria-preview">
    <div class="contenedor">

      <div class="seccion-cabecera reveal">
        <div>
          <p class="etiqueta"><span class="num">04</span> Videos</p>
          <h2>Galería de Videos</h2>
        </div>
        <a href="/galeria" class="enlace-flecha">
          Ver galería <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="reels-preview">
        {reelsPreview.map((url, i) => (
          <div class="reel-card reveal" style={`--d: ${i * 110}ms`}>
            <iframe
              src={`https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=500`}
              loading="lazy"
              title="Reel de Voces Chalatecas"
              scrolling="no"
              allowfullscreen="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            ></iframe>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================
       CONTACTO
  ========================== -->
  <section class="cta">
    <div class="contenedor">
      <div class="cta-contenido tarjeta reveal">
        <p class="etiqueta centrada etiqueta-clara"><span class="num">05</span> Contacto</p>
        <h2>¿Hablamos?</h2>
        <p>
          ¿Tienes alguna idea, propuesta o simplemente quieres ponerte en contacto conmigo? Me encantará leerte, conocer lo que tienes para compartir y conversar contigo.
        </p>
        <a href="/contacto" class="boton boton-claro">ESCRÍBEME</a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Aparición suave al hacer scroll. Se reinicia en cada navegación
  // (View Transitions de Astro).
  function initReveal() {
    const elementos = document.querySelectorAll<HTMLElement>(".reveal");
    if (!elementos.length) return;

    const reducir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducir || !("IntersectionObserver" in window)) {
      elementos.forEach((el) => el.classList.add("visible"));
      return;
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add("visible");
            observador.unobserve(entrada.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
    );

    elementos.forEach((el) => observador.observe(el));
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>

<style>

  /* --------------------------------
     TOKENS Y BASE
  -------------------------------- */

  :global(:root) {
    --linea: rgba(39, 35, 31, 0.14);
    --filete: rgba(138, 117, 97, 0.28);
    --ease-suave: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contenedor {
    width: min(90%, var(--max-width));
    margin: 0 auto;
  }

  section {
    overflow-x: clip;
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Etiqueta de sección: "01 — SOBRE MÍ" */
  .etiqueta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .etiqueta .num {
    color: var(--color-text);
    letter-spacing: 0.08em;
  }

  .etiqueta::after {
    content: "";
    width: 44px;
    height: 1px;
    background: var(--color-accent);
  }

  .etiqueta.centrada {
    justify-content: center;
  }

  .etiqueta.centrada::before {
    content: "";
    width: 44px;
    height: 1px;
    background: var(--color-accent);
  }

  h2 {
    margin: 0 0 22px;
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .enlace-flecha {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--color-accent);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.3s ease, gap 0.3s var(--ease-suave), border-color 0.3s ease;
  }

  .enlace-flecha:hover {
    color: var(--color-accent);
    gap: 16px;
  }

  /* Aparición al hacer scroll */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.9s var(--ease-suave),
      transform 0.9s var(--ease-suave);
    transition-delay: var(--d, 0ms);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* --------------------------------
     TARJETA (contenedor de sección)
     Papel claro, borde fino, sombra suave y
     esquinas en acento que crecen al pasar el mouse.
  -------------------------------- */

  .tarjeta {
    position: relative;
    padding: 64px;
    background: #fbf8f3;
    border: 1px solid var(--linea);
    box-shadow:
      0 1px 2px rgba(39, 35, 31, 0.04),
      0 28px 56px -28px rgba(39, 35, 31, 0.22);
    transition:
      opacity 0.9s var(--ease-suave),
      transform 0.9s var(--ease-suave),
      box-shadow 0.6s ease;
  }

  /* Filete interior: da el aire de una página impresa */
  .tarjeta > * {
    position: relative;
    z-index: 1;
  }

  .tarjeta-filete,
  .tarjeta {
    background-image:
      linear-gradient(var(--filete), var(--filete)),
      linear-gradient(var(--filete), var(--filete)),
      linear-gradient(var(--filete), var(--filete)),
      linear-gradient(var(--filete), var(--filete));
    background-size: calc(100% - 24px) 1px, calc(100% - 24px) 1px, 1px calc(100% - 24px), 1px calc(100% - 24px);
    background-position: center 12px, center calc(100% - 12px), 12px center, calc(100% - 12px) center;
    background-repeat: no-repeat;
  }

  .tarjeta:hover {
    box-shadow:
      0 1px 2px rgba(39, 35, 31, 0.05),
      0 36px 64px -28px rgba(39, 35, 31, 0.3);
  }

  .tarjeta::before,
  .tarjeta::after {
    content: "";
    position: absolute;
    width: 28px;
    height: 28px;
    border: 0 solid var(--color-accent);
    pointer-events: none;
    transition: width 0.6s var(--ease-suave), height 0.6s var(--ease-suave);
  }

  .tarjeta::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .tarjeta::after {
    right: -1px;
    bottom: -1px;
    border-width: 0 2px 2px 0;
  }

  .tarjeta:hover::before,
  .tarjeta:hover::after {
    width: 52px;
    height: 52px;
  }

  .bloque .tarjeta {
    max-width: 1200px;
  }


  /* --------------------------------
     BOTONES
  -------------------------------- */

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 28px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s var(--ease-suave);
  }

  .boton:hover {
    transform: translateY(-2px);
  }

  .boton-primario {
    background: var(--color-button);
    color: #fff;
    border: 1px solid var(--color-button);
  }

  .boton-primario:hover {
    background: var(--color-button-hover);
    border-color: var(--color-button-hover);
  }

  .boton-secundario {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(39, 35, 31, 0.55);
  }

  .boton-secundario:hover {
    background: var(--color-text);
    border-color: var(--color-text);
    color: #fff;
  }

  .boton-claro {
    background: #fff;
    color: var(--color-button);
    border: 1px solid #fff;
  }

  .boton-claro:hover {
    background: transparent;
    color: #fff;
  }


  /* --------------------------------
     HERO
  -------------------------------- */

  .hero {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center top;
    padding-top: 110px;
    min-height: 85vh;
}

.hero-image {
  position: absolute;
  inset: 0;
  background-image: url("/HERO2.jpg");
  background-size: cover;
  background-repeat: no-repeat;
 
  background-position: center top;
  z-index: 0;
  
  transform-origin: 70% 0%;
  animation: hero-zoom 2.6s var(--ease-suave) both;
}

  @keyframes hero-zoom {
    from { transform: scale(1.07); }
    to   { transform: scale(1); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(246, 242, 236, 0.97) 0%,
      rgba(246, 242, 236, 0.9) 28%,
      rgba(246, 242, 236, 0.38) 54%,
      rgba(246, 242, 236, 0) 76%
    );
    z-index: 1;
  }

  /* Desvanecido inferior: el hero se funde con la página */
  .hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 110px;
    background: linear-gradient(180deg, rgba(246, 242, 236, 0), var(--color-background));
    z-index: 1;
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: min(90%, var(--max-width));
    margin: 0 auto;
  }

  .hero-content {
    width: min(100%, 540px);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 26px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-eyebrow .linea {
    width: 38px;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-content h1 {
    margin: 0;
    font-size: clamp(2.7rem, 4.2vw, 4.4rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .hero-subtitle {
    margin: 26px 0 34px;
    font-size: 1.1rem;
    font-style: italic;
    letter-spacing: 0.02em;
    color: var(--color-text-light);
  }

  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Entrada escalonada */
  .hero-eyebrow,
  .hero-content h1,
  .hero-subtitle,
  .hero-botones {
    opacity: 0;
    animation: hero-entrada 1s var(--ease-suave) forwards;
  }

  .hero-eyebrow   { animation-delay: 0.1s; }
  .hero-content h1 { animation-delay: 0.22s; }
  .hero-subtitle  { animation-delay: 0.38s; }
  .hero-botones   { animation-delay: 0.52s; }

  @keyframes hero-entrada {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }


  /* --------------------------------
     FRASE DESTACADA
  -------------------------------- */

  .frase {
    padding: 120px 0 100px;
    text-align: center;
  }

  .frase .contenedor::after {
    content: "";
    display: block;
    width: 1px;
    height: 56px;
    margin: 56px auto 0;
    background: linear-gradient(180deg, var(--color-accent), rgba(138, 117, 97, 0));
  }

  .comilla {
    display: block;
    height: 0.55em;
    margin-bottom: 14px;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.55;
  }

  .frase-texto {
    max-width: 840px;
    margin: 0 auto;
    font-size: clamp(1.45rem, 2.7vw, 2.15rem);
    font-style: italic;
    line-height: 1.5;
    letter-spacing: -0.005em;
    text-wrap: balance;
    color: var(--color-text);
  }


  /* --------------------------------
     BLOQUES (SOBRE MÍ / LIBRO)
  -------------------------------- */

  .bloque {
    padding: 100px 0;
  }

  .bloque-tono {
    background: #ece5db;
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
  }

  .bloque-grid {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 96px;
    align-items: center;
  }

  .bloque-grid-inverso {
    grid-template-columns: 1fr 440px;
  }

  .bloque-texto {
    max-width: 540px;
  }

  .bloque-texto p:not(.etiqueta) {
    margin: 0 0 30px;
    font-size: 1.04rem;
    line-height: 1.8;
    color: var(--color-text-light);
  }

  /* Retrato con marco desplazado */
  .marco {
    position: relative;
    isolation: isolate;
  }

  .marco::before {
    content: "";
    position: absolute;
    inset: 20px -20px -20px 20px;
    border: 1px solid var(--color-accent);
    z-index: -1;
  }

  .marco img {
    display: block;
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: top center;
  }

  /* Portada del libro sobre panel */
  .portada-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 40px;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%),
      #e1d7c8;
    transition: background-color 0.4s ease;
  }

  .portada-panel img {
    display: block;
    width: min(100%, 270px);
    height: auto;
    box-shadow:
      0 2px 4px rgba(39, 35, 31, 0.18),
      0 22px 44px rgba(39, 35, 31, 0.28);
    transition: transform 0.6s var(--ease-suave), box-shadow 0.6s var(--ease-suave);
  }

  .portada-panel:hover img {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow:
      0 4px 8px rgba(39, 35, 31, 0.2),
      0 32px 56px rgba(39, 35, 31, 0.32);
  }


  /* --------------------------------
     POESÍA
  -------------------------------- */

  .poesia {
    padding: 120px 0;
  }

  .poesia-caja {
    max-width: 900px;
    text-align: center;
    padding: 76px 70px 70px;
  }

  /* Separador ornamental: línea con rombo */
  .ornamento {
    position: relative;
    display: block;
    width: 72px;
    height: 1px;
    margin: 6px auto 38px;
    background: var(--color-accent);
    opacity: 0.7;
  }

  .ornamento::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    background: #fbf8f3;
    border: 1px solid var(--color-accent);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .poesia-bloque {
    margin: 0 auto 38px;
  }

  .poesia-verso {
    margin: 0;
    font-size: clamp(1.4rem, 2.7vw, 2.05rem);
    font-style: italic;
    line-height: 1.55;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .poesia-autor {
    margin-top: 22px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }


  /* --------------------------------
     GALERÍA (REELS)
  -------------------------------- */

  .galeria-preview {
    padding: 0 0 120px;
  }

  .seccion-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 44px;
  }

  .seccion-cabecera h2 {
    margin: 0;
  }

  .reels-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 340px));
    justify-content: center;
    gap: 24px;
  }

  /* Cada reel va enmarcado como una impresión: borde de papel + sombra */
  .reel-card {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #111;
    border: 10px solid #fbf8f3;
    box-shadow:
      0 0 0 1px var(--linea),
      0 24px 44px -26px rgba(39, 35, 31, 0.4);
    overflow: hidden;
  }

  .reel-card iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }


  /* --------------------------------
     CONTACTO
  -------------------------------- */

  .cta {
    padding: 100px 0;
    background: var(--color-button);
    color: #fff;
    text-align: center;
  }

  .cta-contenido {
    --filete: rgba(255, 255, 255, 0.16);
    max-width: 700px;
    margin: 0 auto;
    padding: 64px 40px;
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: none;
  }

  .cta-contenido:hover {
    box-shadow: none;
  }

  .cta-contenido::before,
  .cta-contenido::after {
