---
import Layout from "./Layout/Layout.astro";

// Edita aquí los textos y rutas del inicio
const galeriaPreview = [
  { src: "/imagenes/contacto.jpg", alt: "Foto del colectivo 1" },
  { src: "/imagenes/galeria1.jpg", alt: "Foto del colectivo 2" },
  { src: "/imagenes/galeria2s.jpg", alt: "Foto del colectivo 3" },
];
---

<Layout title="Voces Chalatecas | Colectivo Literario">

  <!-- =========================
       HERO
  ========================== -->
  <section class="hero">
    <div class="hero-image"></div>
    <div class="hero-overlay"></div>

    <div class="hero-container">
      <div class="hero-content">

        <p class="hero-eyebrow">Colectivo literario · Chalatenango</p>

        <h1>
          Palabras que<br />
          nacen del alma<br />
          y se quedan en el<br />
          corazón.
        </h1>

        <p class="hero-subtitle">Escritor · Poeta · Soñador</p>

        <div class="hero-botones">
          <a href="/sobre-mi" class="boton boton-primario">CONOCE MI HISTORIA</a>
          <a href="/libro" class="boton boton-secundario">VER EL LIBRO</a>
        </div>

      </div>
    </div>
  </section>


  <!-- =========================
       FRASE DESTACADA
  ========================== -->
  <section class="frase">
    <div class="contenedor">
      <p class="frase-texto reveal">
        “[Una frase tuya que resuma el espíritu del colectivo y de tu escritura.]”
      </p>
    </div>
  </section>


  <!-- =========================
       SOBRE MÍ (VISTA PREVIA)
  ========================== -->
  <section class="bloque">
    <div class="contenedor bloque-grid">

      <div class="bloque-imagen reveal">
        <img
          src="/imagenes/galeria2.jpg"
          alt="Retrato del autor"
          loading="lazy"
        />
      </div>

      <div class="bloque-texto reveal">
        <p class="etiqueta">Sobre mí</p>
        <h2>Una voz nacida en Chalatenango</h2>
        <p>
          [Un párrafo corto: quién eres, cómo empezaste a escribir y qué
          buscas compartir con Voces Chalatecas.]
        </p>
        <a href="/sobre-mi" class="enlace-flecha">Leer mi historia <span aria-hidden="true">→</span></a>
      </div>

    </div>
  </section>


  <!-- =========================
       LIBRO DESTACADO
  ========================== -->
  <section class="bloque bloque-oscuro">
    <div class="contenedor bloque-grid bloque-grid-inverso">

      <div class="bloque-texto reveal">
        <p class="etiqueta">Libro</p>
        <h2>Fronteras Prohibidas</h2>
        <p>
          [Una sinopsis breve de dos o tres líneas que invite a conocer el
          libro.]
        </p>
        <a href="/libro" class="enlace-flecha">Conocer el libro <span aria-hidden="true">→</span></a>
      </div>

      <div class="bloque-imagen portada reveal">
        <img
          src="imagenes/poesia/FronterasProhibidas.jpg"
          alt="Portada del libro"
          loading="lazy"
        />
      </div>

    </div>
  </section>


  <!-- =========================
       POESÍA
  ========================== -->
  <section class="poesia">
    <div class="contenedor reveal">
      <p class="etiqueta">Poesía</p>
      <p class="poesia-verso">
        La inspiración se halla en todas partes; no la busquéis sólo en el corazón de un hombre herido,
o en los amores febriles que arrebatan la vida.

      </p>
      <a href="/poesia" class="enlace-flecha">Leer más poesía <span aria-hidden="true">→</span></a>
    </div>
  </section>


  <!-- =========================
       GALERÍA (VISTA PREVIA)
  ========================== -->
  <section class="galeria-preview">
    <div class="contenedor">

      <div class="seccion-cabecera reveal">
        <div>
          <p class="etiqueta">Fotos</p>
          <h2>Momentos del colectivo</h2>
        </div>
        <a href="/fotos" class="enlace-flecha">Ver galería <span aria-hidden="true">→</span></a>
      </div>

      <div class="galeria-tiras">
        {galeriaPreview.map((foto) => (
          <a href="/fotos" class="galeria-tira reveal" aria-label="Ver la galería de fotos">
            <img src={foto.src} alt={foto.alt} loading="lazy" />
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================
       CONTACTO
  ========================== -->
  <section class="cta">
    <div class="contenedor cta-contenido reveal">
      <h2>¿Escribimos juntos?</h2>
      <p>
        Invítanos a un evento, comparte tu voz con el colectivo o
        simplemente escríbenos.
      </p>
      <a href="/contacto" class="boton boton-primario">ESCRÍBENOS</a>
    </div>
  </section>

</Layout>

<script>
  // Animación suave de aparición al hacer scroll.
  // Se reinicia en cada navegación (View Transitions de Astro).
  function initReveal() {
    const elementos = document.querySelectorAll<HTMLElement>(".reveal");
    if (!elementos.length) return;

    const reducir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducir || !("IntersectionObserver" in window)) {
      elementos.forEach((el) => el.classList.add("visible"));
      return;
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add("visible");
            observador.unobserve(entrada.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );

    elementos.forEach((el) => observador.observe(el));
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>

<style>

  /* --------------------------------
     BASE DE LA PÁGINA
  -------------------------------- */

  .contenedor {
    width: min(90%, var(--max-width));
    margin: 0 auto;
  }

  .etiqueta {
    margin: 0 0 12px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  h2 {
    margin: 0 0 18px;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .enlace-flecha {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-accent);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.25s ease, gap 0.25s ease, border-color 0.25s ease;
  }

  .enlace-flecha:hover {
    color: var(--color-accent);
    gap: 14px;
  }

  /* Aparición al hacer scroll */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* --------------------------------
     BOTONES
  -------------------------------- */

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .boton:hover {
    transform: translateY(-2px);
  }

  .boton-primario {
    background: var(--color-button);
    color: #fff;
    border: 1px solid var(--color-button);
  }

  .boton-primario:hover {
    background: var(--color-button-hover);
    border-color: var(--color-button-hover);
  }

  .boton-secundario {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }

  .boton-secundario:hover {
    background: var(--color-text);
    color: #fff;
  }


  /* --------------------------------
     HERO
  -------------------------------- */

  .hero {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background-image: url("/hero.jpg");
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(246, 242, 236, 0.96) 0%,
      rgba(246, 242, 236, 0.88) 28%,
      rgba(246, 242, 236, 0.35) 52%,
      rgba(246, 242, 236, 0) 75%
    );
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: min(90%, var(--max-width));
    margin: 0 auto;
  }

  .hero-content {
    width: min(100%, 520px);
  }

  .hero-eyebrow {
    margin: 0 0 22px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-content h1 {
    margin: 0;
    font-size: clamp(2.6rem, 4vw, 4.2rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    margin: 22px 0 30px;
    font-size: 1.15rem;
    color: var(--color-text-light);
  }

  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Entrada escalonada del hero */
  .hero-eyebrow,
  .hero-content h1,
  .hero-subtitle,
  .hero-botones {
    opacity: 0;
    animation: hero-entrada 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-eyebrow { animation-delay: 0.05s; }
  .hero-content h1 { animation-delay: 0.15s; }
  .hero-subtitle { animation-delay: 0.3s; }
  .hero-botones { animation-delay: 0.45s; }

  @keyframes hero-entrada {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  /* --------------------------------
     FRASE DESTACADA
  -------------------------------- */

  .frase {
    padding: 90px 0;
    text-align: center;
  }

  .frase-texto {
    max-width: 820px;
    margin: 0 auto;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text);
  }


  /* --------------------------------
     BLOQUES (SOBRE MÍ / LIBRO)
  -------------------------------- */

  .bloque {
    padding: 90px 0;
  }

  .bloque-oscuro {
    background: #ece5db;
  }

  .bloque-grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 80px;
    align-items: center;
  }

  .bloque-grid-inverso {
    grid-template-columns: 1fr 340px;
  }

  .bloque-imagen img {
    display: block;
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: top center;
  }

  .bloque-imagen.portada img {
    height: auto;
    object-fit: contain;
    box-shadow: 0 18px 40px rgba(39, 35, 31, 0.22);
  }

  .bloque-texto {
    max-width: 560px;
  }

  .bloque-texto p {
    margin: 0 0 26px;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  .bloque-texto .etiqueta {
    margin-bottom: 12px;
    color: var(--color-accent);
  }


  /* --------------------------------
     POESÍA
  -------------------------------- */

  .poesia {
    padding: 100px 0;
    text-align: center;
  }

  
.poesia-verso {
  max-width: 560px;
  margin: 0 auto 20px;
  font-size: clamp(0.95rem, 1.5vw, 1.2rem);
  line-height: 1.6;
  letter-spacing: 0;
  text-wrap: pretty;
}



  /* --------------------------------
     GALERÍA (VISTA PREVIA)
  -------------------------------- */

  .galeria-preview {
    padding: 0 0 100px;
  }

  .seccion-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .seccion-cabecera h2 {
    margin: 0;
  }

  .galeria-tiras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .galeria-tira {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e8e1d7;
  }

  .galeria-tira img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .galeria-tira:hover img {
    transform: scale(1.05);
  }


  /* --------------------------------
     LLAMADO A CONTACTO
  -------------------------------- */

  .cta {
    padding: 90px 0;
    background: var(--color-button);
    color: #fff;
    text-align: center;
  }

  .cta-contenido {
    max-width: 640px;
  }

  .cta h2 {
    color: #fff;
  }

  .cta p {
    margin: 0 0 30px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  .cta .boton-primario {
    background: #fff;
    color: var(--color-button);
    border-color: #fff;
  }

  .cta .boton-primario:hover {
    background: var(--color-background);
    border-color: var(--color-background);
  }


  /* --------------------------------
     TABLET
  -------------------------------- */

  @media (max-width: 900px) {

    .hero-content {
      width: min(100%, 420px);
    }

    .bloque-grid {
      grid-template-columns: 320px 1fr;
      gap: 44px;
    }

    .bloque-grid-inverso {
      grid-template-columns: 1fr 280px;
    }

    .bloque-imagen img {
      height: 420px;
    }

  }


  /* --------------------------------
     MÓVIL
  -------------------------------- */

  @media (max-width: 700px) {

    .hero {
      min-height: 680px;
      align-items: flex-end;
    }

    .hero-image {
      background-position: 65% center;
    }

    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(246, 242, 236, 0.05) 0%,
        rgba(246, 242, 236, 0.25) 45%,
        rgba(246, 242, 236, 0.95) 78%,
        rgba(246, 242, 236, 1) 100%
      );
    }

    .hero-container {
      padding-bottom: 55px;
    }

    .hero-content {
      width: 100%;
      max-width: 500px;
    }

    .hero-content h1 {
      font-size: clamp(2.4rem, 10vw, 3.5rem);
    }

    .frase,
    .bloque,
    .poesia,
    .cta {
      padding: 64px 0;
    }

    .galeria-preview {
      padding-bottom: 64px;
    }

    .bloque-grid,
    .bloque-grid-inverso {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    /* En móvil la portada del libro va primero */
    .bloque-grid-inverso .portada {
      order: -1;
      max-width: 240px;
      margin: 0 auto;
    }

    .bloque-imagen img {
      height: auto;
      max-height: 460px;
    }

    .bloque-texto {
      max-width: 100%;
    }

    .seccion-cabecera {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .galeria-tiras {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .galeria-tira:last-child {
      display: none;
    }

  }


  /* --------------------------------
     MENOS MOVIMIENTO
  -------------------------------- */

  @media (prefers-reduced-motion: reduce) {

    .hero-eyebrow,
    .hero-content h1,
    .hero-subtitle,
    .hero-botones {
      animation: none;
      opacity: 1;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }

</style>