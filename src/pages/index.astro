---
import Layout from "./Layout/Layout.astro";
---

<Layout>
  <!-- =========================
       BANNER O HERO
  ========================== -->
  <section class="hero">

    <!-- Imagen de fondo -->
    <div class="hero-image"></div>

    <!-- Degradado para mejorar la lectura -->
    <div class="hero-overlay"></div>

    <!-- Contenido -->
    <div class="hero-container">
      <div class="hero-content">

        <!-- Título o texto principal para el banner -->
        <h1>
          Palabras que<br />
          nacen del alma<br />
          y se quedan en el<br />
          corazón.
        </h1>

        <p class="hero-subtitle">
          Escritor · Poeta · Soñador
        </p>

        <!-- Botón para información biográfica -->
        <a href="#sobre-mi" class="hero-button">
          CONOCE MI HISTORIA
        </a>

      </div>
    </div>

  </section>
</Layout>

<style>

  /* --------------------------------
     HERO
  -------------------------------- */

  .hero {
    position: relative;
    min-height: 560px;

    overflow: hidden;

    display: flex;
    align-items: center;
  }


  /* Imagen */

  .hero-image {
    position: absolute;
    inset: 0;

    background-image: url("/hero.jpg");
    background-size: cover;
    background-position: center;

    z-index: 0;
  }


  /* Degradado */

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(248, 245, 240, 0.96) 0%,
        rgba(248, 245, 240, 0.88) 28%,
        rgba(248, 245, 240, 0.35) 52%,
        rgba(248, 245, 240, 0) 75%
      );

    z-index: 1;
  }


  /* Contenedor */

  .hero-container {
    position: relative;
    z-index: 2;

    width: min(90%, var(--max-width));
    margin: 0 auto;
  }


  /* Texto */

  .hero-content {
    width: min(100%, 470px);
  }

  .hero-content h1 {
    margin: 0;

    font-size: clamp(2.6rem, 4vw, 4.2rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    margin: 22px 0 28px;

    font-size: 1.15rem;
    color: var(--color-text-light);
  }


  /* --------------------------------
     BOTÓN HERO
  -------------------------------- */

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 48px;
    padding: 0 24px;

    background: var(--color-button);
    color: #ffffff;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;

    transition:
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .hero-button:hover {
    background: var(--color-button-hover);
    transform: translateY(-2px);
  }


  /* --------------------------------
     RESPONSIVE
  -------------------------------- */

  @media (max-width: 900px) {

    .hero-content {
      width: min(100%, 400px);
    }

  }


  /* --------------------------------
     MÓVIL
  -------------------------------- */

  @media (max-width: 700px) {

    .hero {
      min-height: 650px;
      align-items: flex-end;
    }

    .hero-image {
      background-position: 65% center;
    }

    .hero-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(248, 245, 240, 0.05) 0%,
          rgba(248, 245, 240, 0.25) 45%,
          rgba(248, 245, 240, 0.95) 78%,
          rgba(248, 245, 240, 1) 100%
        );
    }

    .hero-container {
      padding-bottom: 55px;
    }

    .hero-content {
      width: 100%;
      max-width: 500px;
    }

    .hero-content h1 {
      font-size: clamp(2.4rem, 10vw, 3.5rem);
    }

  }

</style>