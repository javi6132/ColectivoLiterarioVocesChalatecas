---
import Header from "../Componentes/Header.astro";
import Footer from "../Componentes/Footer.astro";
import { ClientRouter } from "astro:transitions";

const { title = "Voces Chalatecas | Colectivo Literario" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Colectivo Literario Voces Chalatecas"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <Header />

    <main transition:name="contenido" transition:animate="none">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-text: #27231f;
    --color-text-light: #5e574f;
    --color-accent: #8a7561;
    --color-button: #29241f;
    --color-button-hover: #75614e;
    --color-background: #f6f2ec;
    --max-width: 1400px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: Georgia, "Times New Roman", serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ===== TRANSICIÓN ENTRE PÁGINAS ===== */
  

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  @keyframes salida-contenido {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes entrada-contenido {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  ::view-transition-old(contenido) {
    animation: 0.35s ease-out both salida-contenido;
  }

  ::view-transition-new(contenido) {
    animation: 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both entrada-contenido;
  }

 
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(contenido),
    ::view-transition-new(contenido) {
      animation: none !important;
    }
  }
</style>