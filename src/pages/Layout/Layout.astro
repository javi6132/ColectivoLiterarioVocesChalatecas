---

import Header from "../Componentes/Header.astro";

const { title = "Voces Chalatecas | Colectivo Literario" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Colectivo Literario Voces Chalatecas"
    />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --color-text: #27231f;
    --color-text-light: #5e574f;
    --color-accent: #8a7561;
    --color-button: #29241f;
    --color-button-hover: #75614e;
    --color-background: #f6f2ec;
    --max-width: 1400px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: Georgia, "Times New Roman", serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>