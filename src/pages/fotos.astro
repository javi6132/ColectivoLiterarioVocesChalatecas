---
import Layout from "./Layout/Layout.astro";

// Reels de Facebook: 
const reels = [
  "https://www.facebook.com/reel/1642400850890747",
  "https://www.facebook.com/reel/2022541381804764",
  "https://www.facebook.com/reel/1302387908675615",
  "https://www.facebook.com/reel/1025897093115596",
];
---

<Layout title="Galería | Voces Chalatecas">
  <section class="galeria" id="galeria">
    <div class="galeria-container">

      <h1>Galería</h1>
      <p class="galeria-intro">
        Un vistazo a nuestros videos.
      </p>

      <div class="reels-grid">
        {reels.map((url) => (
          <iframe
            src={`https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=267`}
            width="267"
            height="476"
            loading="lazy"
            title="Reel de Voces Chalatecas"
            style="border:none;overflow:hidden"
            allowfullscreen="true"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          ></iframe>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .galeria {
    padding: 30px 0 80px;
  }

  .galeria-container {
    width: min(90%, 1100px);
    margin: 0 auto;
  }

  h1 {
    margin: 0 0 15px;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .galeria-intro {
    margin: 0 0 40px;
    line-height: 1.7;
    max-width: 700px;
  }

  /* REELS */
  .reels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(267px, 1fr));
    gap: 18px;
    justify-items: center;
  }

  /* MÓVIL */
  @media (max-width: 600px) {
    .galeria {
      padding: 20px 0 60px;
    }
  }
</style>